generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Wine {
  id          String @id @default(uuid())
  name        String
  description String

  color        String
  sweetness    String
  volume       Float
  alcohol      String
  grapeVariety String

  inStock    Boolean     @default(true)
  images     String[]    @default([])
  reviews    Review[]
  awards     Award[]
  price      Float       @default(0)
  orderItems OrderItem[]
}

model Award {
  id          String   @id @default(uuid())
  title       String
  description String?
  year        String?
  image       String?
  wineId      String
  wine        Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model ContactSettings {
  id           String   @id @default("default")
  phone        String   @default("050-317-9452")
  email        String   @default("vine.shtufko@gmail.com")
  address      String   @default("с. Ключарки, вул. Миру, 45")
  workingHours String   @default("Пн-Пт: 09:00 - 18:00")
  facebookUrl  String   @default("https://www.facebook.com/Shtifko")
  instagramUrl String   @default("https://www.instagram.com/shtufko/")
  updatedAt    DateTime @updatedAt
}

model User {
  id       String  @id @default(uuid())
  username String  @unique
  email    String? @unique
  password String
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  images    String[] @default([])
  createdAt DateTime @default(now())
}

model Review {
  id         String   @id @default(uuid())
  authorName String
  rating     Int
  text       String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  wineId     String
  wine       Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade)
}

model About {
  id        String   @id @default(cuid())
  content   String
  updatedAt DateTime @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  amount          Float       @default(0)
  status          String      @default("PENDING")
  invoiceId       String?

  customerName    String?
  customerSurname String?
  customerPhone   String?
  customerCity    String?
  customerBranch  String?

  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wineId   String
  wine     Wine   @relation(fields: [wineId], references: [id])
  quantity Int
  price    Float
}


